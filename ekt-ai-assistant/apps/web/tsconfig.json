{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@contract": [
        "./src/types/contract.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-test-live/types/**/*.ts",
    ".next-test-live/dev/types/**/*.ts",
    ".next-test-demo/types/**/*.ts",
    ".next-test-demo/dev/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next-preview/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
